<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101828">
<title>VendaMais — Marketplace</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f5f8;color:#172033}header{background:#101828;color:white;padding:22px 16px}header h1{margin:0 0 8px;font-size:28px}header p{margin:0;color:#cbd5e1}main{max-width:900px;margin:auto;padding:16px}input{width:100%;padding:14px;border:1px solid #ccd3df;border-radius:12px;font-size:16px;margin:8px 0 16px}.cats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.cats button,.sell{border:0;border-radius:10px;padding:11px 14px;background:#e0e7ff;color:#263c91;font-weight:bold;cursor:pointer}.sell{background:#176b46;color:white;width:100%;padding:14px;margin:10px 0 20px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.item{background:white;border-radius:14px;padding:14px;box-shadow:0 2px 8px #15223810}.pic{height:95px;display:grid;place-items:center;background:#edf1f7;border-radius:10px;font-size:42px}.item h3{font-size:16px;margin:12px 0 6px}.price{font-size:19px;font-weight:bold;color:#147849}.item p{font-size:13px;color:#667085}.item a{display:block;text-align:center;text-decoration:none;background:#176b46;color:white;border-radius:9px;padding:10px;margin-top:10px}.note{font-size:12px;color:#667085;margin:20px 0}@media(min-width:600px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
</head>
<body>
<header><h1>VendaMais 🛍️</h1><p>Descobre ofertas. Anuncia os teus produtos.</p></header>
<main>
<h2>Encontra o que procuras</h2>
<input id="search" placeholder="Pesquisar produtos..." aria-label="Pesquisar produtos">
<div class="cats"><button data-cat="Todos">Todos</button><button data-cat="Tecnologia">Tecnologia</button><button data-cat="Moda">Moda</button><button data-cat="Casa">Casa</button></div>
<button class="sell" id="seller">＋ Quero anunciar um produto</button>
<h2>Produtos em destaque</h2>
<div class="grid" id="products"></div>
<p class="note">Versão inicial de demonstração. Os produtos são exemplos; ainda não há pagamentos nem anúncios publicados na internet.</p>
</main>
<script>
const products=[{name:"Fone Bluetooth",cat:"Tecnologia",price:59.90,icon:"🎧"},{name:"Tênis casual",cat:"Moda",price:89.90,icon:"👟"},{name:"Relógio digital",cat:"Tecnologia",price:74.90,icon:"⌚"},{name:"Mochila",cat:"Moda",price:69.90,icon:"🎒"},{name:"Luminária",cat:"Casa",price:39.90,icon:"💡"},{name:"Garrafa térmica",cat:"Casa",price:34.90,icon:"🥤"}];let category="Todos";const money=n=>n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});function render(){const q=document.getElementById("search").value.toLowerCase();const list=products.filter(p=>(category==="Todos"||p.cat===category)&&(p.name.toLowerCase().includes(q)||p.cat.toLowerCase().includes(q)));document.getElementById("products").innerHTML=list.map(p=>`<article class="item"><div class="pic">${p.icon}</div><h3>${p.name}</h3><div class="price">${money(p.price)}</div><p>${p.cat} · Produto de exemplo</p><a href="#" class="contact" data-name="${p.name}">Tenho interesse</a></article>`).join("")||"<p>Nenhum produto encontrado.</p>";document.querySelectorAll(".contact").forEach(a=>a.onclick=e=>{e.preventDefault();alert("Este anúncio é demonstrativo. A área de contacto será adicionada numa próxima etapa.")})}document.getElementById("search").addEventListener("input",render);document.querySelectorAll("[data-cat]").forEach(b=>b.onclick=()=>{category=b.dataset.cat;render()});document.getElementById("seller").onclick=()=>alert("Cadastro de vendedores será a próxima função que vamos construir.");render();
</script>
</body>
</html>
